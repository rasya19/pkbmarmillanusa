# MASUKKAN API KEY GEMINI DARI https://aistudio.google.com/
# Kode harus diawali dengan "AIza..."
# Isi di Vercel dengan nama: VITE_GEMINI_API_KEY
VITE_GEMINI_API_KEY=

# URL GOOGLE APPS SCRIPT DARI SPREADSHEET ANDA
# Pastikan sudah di-deploy sebagai Web App dengan akses "Anyone"
# Isi di Vercel dengan nama: VITE_APP_URL
VITE_APP_URL=

# CUSTOM ADMIN LOGIN (Opsional)
# Isi di Vercel untuk mengganti login default admin
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=admin123

VITE_SCHOOL_NAME="Armilla Nusa"
# SUPABASE CONFIGURATION (Wajib diisi di Vercel/Settings)
# Gunakan prefix VITE_ atau NEXT_PUBLIC_ agar terbaca di Frontend
# Contoh di Vercel:
# Variable Name: VITE_SUPABASE_URL
# Variable Value: https://xyz.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel API Keys for Domain Management (Optional - only required if you want automatic subdomain/domain management)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID is OPTIONAL. Leave it empty if you are using a Vercel Personal account.
VERCEL_TEAM_ID=
